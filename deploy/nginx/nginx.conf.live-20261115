worker_processes  1;
events {
    worker_connections  1024;
}
http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout  65;

    # HTTP(80) → HTTPS(443) 자동 전환
    server {
        listen       80;
        server_name  dongsinmarket.co.kr www.dongsinmarket.co.kr dongsinmarket.com www.dongsinmarket.com;

        # SSL 인증서 갱신용 경로는 예외로 http 허용
        location /.well-known/acme-challenge/ {
            root C:/srmart/homepage;
        }

        # POS 목업 뷰어 (D3 Pro가 Tailscale IP로 직접 접속하는 내부 전용 임시 화면 — HTTPS 리다이렉트 대상 아님)
        # ^~ : 이 prefix가 매칭되면 정규식 location 검사 없이 즉시 이걸로 확정(의도 명시용, 이 파일엔
        # 아직 경쟁하는 정규식 location이 없어 필수는 아니지만 향후 추가돼도 안전하게 우선권 유지)
        location ^~ /pos-mockup/ {
            # [port80-guard] 🔴 **바깥(인터넷)에서 평문으로 닿는 것을 막는다** (2026-10-21)
            #
            # 🔴 내부 전용 목업 뷰어 — 바깥에서 열려 있었다(실측 200).
            #    전체 접속 기록에서 **바깥 출처 요청이 0건**이라 막아도 끊기는 곳이 없다.
            #
            allow 100.64.0.0/10;      # Tailscale (CGNAT) — 동신포스 D3·A12 가 이 길로 붙는다
            allow 192.168.0.0/16;     # 매장 내부망
            allow 127.0.0.1;          # 이 서버 자신 (루프백)
            deny  all;                # 🔴 그 밖 전부 — 인터넷 포함

            alias C:/srmart/srmart-pos-mockup/;
            index index.html;
            try_files $uri $uri/ /pos-mockup/index.html;
        }
        location = /pos-mockup {
            return 301 /pos-mockup/;
        }

        # 목업 페이지가 상대경로로 fetch('/api/...')를 부르는데, 이걸 https로 리다이렉트시키면
        # D3 Pro가 Tailscale IP(도메인 아님)로 붙기 때문에 인증서 호스트명 불일치로 SSL 에러가
        # 나서 API 호출 자체가 막힌다(아까 favicon.ico https 요청이 SSL 에러로 차단된 것과 동일
        # 패턴, logcat에서 실측 확인됨) — 그래서 /pos-mockup/과 마찬가지로 http 그대로 프록시한다.
        location /api {
            # [port80-guard] 🔴 **바깥(인터넷)에서 평문으로 닿는 것을 막는다** (2026-10-21)
            #
            # 🔴 이 :80 블록은 이 포트의 **기본 서버**다 — Host 가 무엇이든(공인 IP 를 그대로
            #    넣어도) 여기로 들어온다. 그리고 `location /api` 가 `location /` 의 https
            #    리다이렉트보다 **먼저** 맞는다. 그래서 2026-10-21 까지
            #        http://112.217.202.242/api/health → 200 {"ok":true}  (평문)
            #    가 인터넷에 열려 있었다(대표님 휴대폰 LTE 로 확인).
            # 
            # 🔴 블록 자체를 지울 수는 없다 — 동신포스(D3·A12)가 이 길로 붙는다
            #    (srmart-pos/src/config/env.ts: http://100.73.58.124/api). Tailscale IP 에는
            #    도메인 인증서가 안 맞아 https 로 바꿀 수도 없다. 다만 Tailscale 구간은
            #    WireGuard 가 암호화하므로 선 위에 평문이 흐르는 구간은 없다 —
            #    **문제는 "누가 접속할 수 있나" 였다.** 그래서 출처로 가른다.
            # 
            # 🔴 서버 자신의 **공인 주소(112.217.202.242)는 일부러 허용하지 않는다.**
            #    그 출처로 /api 요청이 20.9만 건 있지만 그건 서버 PC 에 띄워 둔 어드민이고
            #    **443 을 쓴다** — 같은 출처가 /admin/ 1,936건 · /shop/ 642건을 받았고 그 두
            #    경로는 **443 블록에만 있다**(:80 에는 없다). 즉 이 deny 는 어드민을 끊지 않는다.
            #    허용하지 않는 까닭: 허용하면 **이 서버에서 차단을 확인할 수가 없다**(바깥
            #    주소로 curl 해도 출처가 자기 자신이라 통과한다). 스스로 막혔는지 못 재는
            #    보호장치는 조용히 풀려도 아무도 모른다.
            # 
            # 443 쪽 /api 는 손대지 않는다 — 어드민·쇼핑앱이 인터넷에서 그 길로 붙는다(TLS).
            #
            allow 100.64.0.0/10;      # Tailscale (CGNAT) — 동신포스 D3·A12 가 이 길로 붙는다
            allow 192.168.0.0/16;     # 매장 내부망
            allow 127.0.0.1;          # 이 서버 자신 (루프백)
            deny  all;                # 🔴 그 밖 전부 — 인터넷 포함

            client_max_body_size 6m;
            proxy_pass http://127.0.0.1:5000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # 백엔드(helmet 기본 설정)가 모든 응답에 Strict-Transport-Security를 붙이는데, 그걸
            # 평문 http 응답에 실어 보내면(스펙 위반이지만) D3 Pro WebView가 그대로 따라서 이
            # 호스트(Tailscale IP)를 "항상 https로만" 접속하도록 각인해버릴 위험이 있다 — IP엔
            # 도메인용 인증서라 https가 아예 안 되므로 한번 각인되면 영구 접속 불가가 된다.
            # http 응답엔 HSTS를 절대 실어보내지 않는 게 원칙적으로도 맞다(포트 80 전체에 적용).
            proxy_hide_header Strict-Transport-Security;
        }

        # 업로드 이미지 — http(80) 에서도 그대로 내보낸다.
        # 동신포스(D3 Pro)는 Tailscale IP 로 붙는데, 여기서 https 로 301 을 보내면 IP 에는
        # 도메인용 인증서라 핸드셰이크가 실패해 **상품 이미지가 통째로 안 나온다**
        # (2026-09-23 광고판 실측 — 이미지 자리가 빈 채로 레이아웃만 잡혔다).
        # /api·/pos-mockup 을 http 로 두는 것과 같은 이유다. 443 쪽 블록과 내용 동일.
        location /uploads/ {
            alias D:/srmart_uploads/;
            expires 7d;
            add_header Cache-Control "public, immutable" always;
            # [보안] 저장형 XSS 백스톱: MIME 스니핑 차단 + 스크립트 차단 CSP + 샌드박스
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; sandbox" always;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # HTTPS(443) 본 서비스
    server {
        listen       443 ssl;
        server_name  dongsinmarket.co.kr www.dongsinmarket.co.kr dongsinmarket.com www.dongsinmarket.com;

        ssl_certificate      C:/nginx/ssl/dongsinmarket.co.kr-chain.pem;
        ssl_certificate_key  C:/nginx/ssl/dongsinmarket.co.kr-key.pem;
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_ciphers          HIGH:!aNULL:!MD5;

       # 개인정보처리방침
        location = /privacy {
            root C:/srmart/homepage;
            try_files /privacy.html =404;
        }

        # POS 목업 뷰어 — http(80) 쪽과 동일 내용. 어떤 경로로든(직접 https 접속, 프록시의 자동
        # 업그레이드 등) https로 들어와도 홈페이지로 흡수되지 않고 똑같이 뜨도록 이중 보강.
        location ^~ /pos-mockup/ {
            alias C:/srmart/srmart-pos-mockup/;
            index index.html;
            try_files $uri $uri/ /pos-mockup/index.html;
        }
        location = /pos-mockup {
            return 301 /pos-mockup/;
        }

        # 목업 전용 API 경로 — 실서비스 /api(아래)와 달리 HSTS를 안 붙인다. 이 https 443으로는
        # D3 Pro가 정상적으로 못 들어오지만(인증서가 도메인용이라 Tailscale IP 접속 시 핸드셰이크
        # 자체가 실패), 혹시라도 들어왔을 때 HSTS가 다시 각인되는 걸 막는 이중 방어. /api보다
        # prefix가 더 길어서(더 구체적이라) 순서 상관없이 이게 먼저 매치된다.
        location ^~ /api/pos/mockup {
            client_max_body_size 6m;
            proxy_pass http://127.0.0.1:5000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_hide_header Strict-Transport-Security;
        }

       # 홈페이지 (회사 안내)
        location / {
            root   C:/srmart/homepage;
            index  index.html;
            try_files $uri $uri/ /index.html;
        }

        # 쇼핑몰 (3000번)
        location /shop/ {
            proxy_pass http://127.0.0.1:3000/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location = /shop {
            return 301 /shop/;
        }

        # 어드민 (4000번)
        location /admin/ {
            proxy_pass http://127.0.0.1:4000/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        location = /admin {
            return 301 /admin/;
        }

        # 백엔드 API (5000번)
        location /api {
            client_max_body_size 6m;   # 이미지 업로드(multer 5MB) 허용 — 기본 1MB면 세로 광고 등 큰 이미지가 413으로 차단됨
            proxy_pass http://127.0.0.1:5000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # 업로드 이미지 (D 드라이브)
        location /uploads/ {
            alias D:/srmart_uploads/;
            expires 7d;
            add_header Cache-Control "public, immutable" always;
            # [보안] 저장형 XSS 백스톱: MIME 스니핑 차단 + 스크립트 차단 CSP + 샌드박스
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy "default-src 'none'; img-src 'self' data:; sandbox" always;
        }
    }
}